build 15 drone 80
build 1 ultralisk_cavern 80
build 1 defiler_mound 80
upgrade 1 hydra_attack 30
upgrade 3 z_carapace 30
upgrade 3 z_flyer_carapace 30
upgrade 3 z_melee_attack 30
upgrade 3 z_missile_attack 30
upgrade 1 ultralisk_armor 30
upgrade 1 defiler_mana 30
upgrade 1 queen_mana 30
call wait_attack
call hold_attack
attack_add 2 ultralisk
attack_add 1 hdefiler
attack_add 1 defiler
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
upgrade 1 bone_mastery 30
upgrade 1 voracity 30
upgrade 2 z_flyer_attack 30
:castLoop
wait 5333

call wait_attack
call hold_attack
attack_add 2 queen
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
wait 1550

call wait_attack
call hold_attack
attack_add 2 defiler
attack_add 2 hdefiler
attack_add 4 ultralisk
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
wait 6500

call wait_attack
call hold_attack
attack_add 2 ultralisk
attack_add 3 queen
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
goto castLoop

:brown_lurkers
define_max 6 lurker
define_max 7 guardian
define_max 7 mutalisk
define_max 12 hydralisk
define_max 20 zergling
define_max 4 scourge
tech burrowing 30
tech lurker_aspect 30
upgrade 1 overlord_speed 30
upgrade 1 overlord_capacity 30
upgrade 1 z_flyer_attack 30
upgrade 1 z_missile_attack 30
upgrade 1 lurker_speed 30
wait 4750

upgrade 1 z_melee_attack 30
build 2 drone 80
call wait_attack
call hold_attack
train 3 hydralisk
train 3 lurker
attack_add 3 lurker
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
upgrade 1 hydralisk_speed 30
upgrade 2 z_missile_attack 30
upgrade 1 z_carapace 30
wait 5500

call wait_attack
call hold_attack
train 2 hydralisk
train 2 lurker
attack_add 2 lurker
attack_prepare
wait 300

attack_do
attack_clear
build 5 drone 80
call release_attack
upgrade 1 hydralisk_range 30
upgrade 2 z_carapace 30
upgrade 2 z_flyer_attack 30
wait 4500

upgrade 1 z_flyer_carapace 30
upgrade 2 z_flyer_carapace 30
call wait_attack
call hold_attack
train 4 hydralisk
train 4 lurker
attack_add 4 lurker
attack_prepare
wait 300

attack_do
attack_clear
build 6 drone 80
player_need 1 spawning_pool
build 1 lair 80
build 1 hydralisk_den 80
call release_attack
:spiky_loop
wait 6000

call wait_attack
call hold_attack
train 6 hydralisk
train 6 lurker
attack_rand 3 6 lurker
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
goto spiky_loop

:ai_income
time_jump 43 generic_void
#stop subsidies after we show off "recovery"
wait 16

resources_jump 2000 2000 income_throttle
resources 13 Add Ore 9 ai_income
resources 13 Add Gas 7 ai_income
goto ai_income

:income_throttle
wait_rand 500 1500

goto ai_income

:hold_attack
deaths 13 Add 1 firebat generic_void
return

:release_attack
deaths 13 Set 0 firebat generic_void
return

:wait_attack
wait 16

deaths 13 AtLeast 2 firebat ensure_attack
deaths 13 Exactly 1 firebat wait_attack
#loop if another script started an attack
return

:ensure_attack
load_bank Ensures
print Ensure_TwoOrMore_PleaseReportMeIfSeen
bank_data Set 1 Ensures Ensure_TwoOrMore wait_attack
bank_data Set 0 Ensures Ensure_Compare wait_attack
save_bank Ensures
deaths 13 Set 0 firebat generic_void
return

:generic_void
wait 500

stop
