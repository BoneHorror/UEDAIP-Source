script_name Brood Wars Zerg 2 - Town A
script_id ZB2A

start_campaign
wait 1

start_town
defaultbuild_off
default_min 1
wait 1

idle_orders disablebuiltin 0 0 0 0 0 0 0
multirun ai_income
upgrade_jump 13 Set 74 5 ai_income
define_max 25 overlord
build 1 hatchery 80
#new idea: drones recover over time so that we show zerg gradually weening off when left alone for long enough. just feral doesn't feel good!
notowns_jump spire brown_lurkers
if_owned defiler_mound white_casters
#:orange - infested island
define_max 10 zergling
define_max 7 hydralisk
define_max 6 infested_terran
define_max 5 mutalisk
define_max 4 scourge
defensebuild_gg 1 infested_terran
defenseuse_gg 2 infested_terran
defensebuild_gg 1 mutalisk
defenseuse_gg 1 mutalisk
defensebuild_ag 1 mutalisk
defenseuse_ag 1 mutalisk
defenseuse_ag 1 hydralisk
defensebuild_ga 1 mutalisk
defenseuse_ga 1 mutalisk
defensebuild_aa 1 scourge
defenseuse_aa 1 scourge
tech burrowing 30
upgrade 1 overlord_speed 30
upgrade 1 overlord_capacity 30
wait 8025

call wait_attack
call hold_attack
attack_add 2 infested_terran
attack_add 2 mutalisk
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
build 1 drone 80
upgrade 1 z_flyer_attack 30
upgrade 1 z_carapace 30
upgrade 1 z_melee_attack 30
upgrade 1 z_flyer_carapace 30
wait 5150

build 3 drone 80
call wait_attack
call hold_attack
attack_add 2 mutalisk
attack_add 2 scourge
attack_add 1 infested_terran
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
upgrade 2 z_flyer_attack 30
upgrade 2 z_carapace 30
upgrade 2 z_melee_attack 30
upgrade 2 z_flyer_carapace 30
build 5 drone 80
player_need 1 spawning_pool
build 1 lair 80
build 1 spire 80
player_need 1 evolution_chamber
:infLoop
wait 2025

call wait_attack
call hold_attack
attack_add 4 mutalisk
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
wait 6125

call wait_attack
call hold_attack
attack_add 4 infested_terran
attack_add 2 scourge
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
wait 4500

call wait_attack
call hold_attack
attack_add 5 mutalisk
attack_add 2 infested_terran
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
wait 4775

call wait_attack
call hold_attack
attack_add 4 mutalisk
attack_add 2 scourge
attack_add 3 infested_terran
attack_prepare
wait 300

attack_do
attack_clear
call release_attack
goto infLoop

