script_name Brood Wars Zerg 4 - Town A
script_id ZB4A

start_campaign
wait 1

start_town
defaultbuild_off
default_min 0
wait 1

build 1 hatchery 160
build 1 lair 120
build 1 hive 120
build 1 drone 130
build 14 drone 80
build 1 spawning_pool 80
player_need 1 evolution_chamber
build 1 hydralisk_den 80
build 1 spire 80
build 1 greater_spire 80
player_need 1 queen_nest
build 8 creep_colony 80
build 3 sunken_colony 80
build 5 spore_colony 80
idle_orders DisableBuiltin 0 0 0 0 0 0 0
upgrade_jump 2 Set 74 4 block1
upgrade_jump 3 Set 74 4 block1
upgrade_jump 4 Set 74 4 block1
max_workers 18 
define_max 44 zergling
define_max 6 hzergling
define_max 60 drone
define_max 17 mutalisk
define_max 12 scourge
define_max 6 guardian
define_max 12 ultralisk
define_max 2 hultralisk
define_max 5 defiler
define_max 3 hdefiler
define_max 28 hydralisk
define_max 10 hhydralisk
define_max 3 lurker
define_max 30 overlord
defensebuild_gg 2 zergling
defenseuse_gg 2 zergling
defensebuild_gg 1 hzergling
defenseuse_gg 1 hzergling
defensebuild_gg 1 ultralisk
defenseuse_gg 1 ultralisk
defensebuild_gg 2 hydralisk
defenseuse_gg 1 hydralisk
defensebuild_gg 1 lurker
defenseuse_gg 1 lurker
defensebuild_ag 1 hydralisk
defenseuse_ag 1 hydralisk
defensebuild_ag 1 defiler
defenseuse_ag 1 defiler
defensebuild_ag 1 mutalisk
defenseuse_ag 1 mutalisk
defensebuild_ag 1 hhydralisk
defenseuse_ag 1 hhydralisk
defensebuild_ga 1 guardian
defenseuse_ga 1 guardian
defensebuild_ga 2 mutalisk
defenseuse_ga 1 mutalisk
defensebuild_aa 1 mutalisk
defenseuse_aa 1 mutalisk
defensebuild_aa 1 scourge
defenseuse_aa 1 scourge
max_force 350
upgrade 1 overlord_speed 30
upgrade 1 overlord_capacity 30
tech burrowing 30
upgrade 1 z_carapace 30
upgrade 1 z_flyer_carapace 30
upgrade 1 zergling_speed 30
upgrade 1 z_melee_attack 30
upgrade 1 z_missile_attack 30
upgrade 1 z_flyer_attack 30
multirun ygg_idle
wait 1500

upgrade 1 hydralisk_range 30
wait 5600

call wait_attack
call hold_attack
attack_add 1 guardian
attack_to Loc.14 Loc.18
#TODO attack through mid towards taar
wait 500

attack_do
attack_clear
upgrade 2 z_melee_attack 30
upgrade 2 z_carapace 30
upgrade 2 z_flyer_carapace 30
upgrade 1 voracity 30
call release_attack
wait 5300

upgrade 1 hydralisk_speed 30
upgrade 2 z_missile_attack 30
upgrade 2 z_flyer_attack 30
upgrade 3 z_carapace 30
upgrade 3 z_flyer_carapace 30
wait 2500

call wait_attack
call hold_attack
attack_add 10 zergling
attack_add 2 hydralisk
#TODO attack player
call waypointing
wait 500

attack_do
attack_clear
tech spawn_broodling 30
call release_attack
wait 4205

call wait_attack
call hold_attack
upgrade 3 z_melee_attack 30
upgrade 1 hydra_attack 30
attack_add 9 hydralisk
call waypointing
wait 500

attack_do
attack_clear
upgrade 1 zergling_attack 30
call release_attack
wait 3500

call wait_attack
call hold_attack
#upgrade new zerg claw thingy TODO
attack_add 2 hzergling
attack_add 18 zergling
call waypointing
wait 500

attack_do
attack_clear
tech ensnare 30
upgrade 3 z_missile_attack 30
upgrade 3 z_flyer_attack 30
:block1
call release_attack
wait 5100

call wait_attack
call hold_attack
attack_add 11 hydralisk
attack_add 7 mutalisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
wait 3750

call wait_attack
call hold_attack
attack_add 6 guardian
attack_add 6 mutalisk
attack_add 1 queen
call waypointing
wait 500

attack_do
attack_clear
call release_attack
wait 4500

call wait_attack
call hold_attack
attack_add 28 hydralisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
wait 7000

call wait_attack
call hold_attack

attack_add 3 hzergling
attack_add 18 zergling
attack_add 4 guardian
attack_add 5 mutalisk
call waypointing
wait 500

attack_do
attack_clear
goto block1

:waypointing
wait 16

#pick targets based on player presence, fallback to random otherwise
#should not trigger ensure because this is only ran after the safeguard
#use CARRIER death to force fallback
random_jump 64 middle_approach
random_jump 85 north_approach
random_jump 128 south_approach
unstart_campaign
attack_prepare
start_campaign
return

:nomiddle
wait 8

deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 north_approach
random_jump 128 south_approach
goto waypointing

:nosouth
wait 8

deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 north_approach
random_jump 128 middle_approach
goto waypointing

:nonorth
wait 8

random_jump 64 target_player_island
deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 middle_approach
random_jump 128 south_approach
goto waypointing

:target_player_island
attack_to Loc.54 Loc.55
return

:north_approach
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.61 nonorth
random_jump 85 alt_north
attack_to Loc.62 Loc.61
return

:alt_north
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.31 nonorth
attack_to Loc.62 Loc.31
return

:south_approach
wait 8

random_jump 128 alt_south
attack_to Loc.20 Loc.60
return

:alt_south
wait 8

bring_jump 14 AtMost 3 group_buildings Loc.114 nosouth
attack_to Loc.64 Loc.65
return

:middle_approach
wait 8

random_jump 128 alt_middle
bring_jump 14 AtMost 1 group_buildings Loc.13 nomiddle
attack_to Loc.42 Loc.13
return

:alt_middle
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.22 nomiddle
attack_to Loc.42 Loc.22
return

:fallback
deaths 13 Set 0 carrier waypointing
attack_prepare
return


:hold_attack
deaths 3 Add 1 firebat block1
return

:release_attack
deaths 3 Set 0 firebat block1
return

:wait_attack
wait 16

deaths 3 AtLeast 2 firebat ensure_attack
deaths 3 Exactly 1 firebat wait_attack
#loop if another script started an attack
return

:ensure_attack
load_bank Ensures
print Ensure_TwoOrMore_PleaseReportMeIfSeen
bank_data Set 1 Ensures Ensure_TwoOrMore wait_attack
bank_data Set 0 Ensures Ensure_Compare wait_attack
save_bank Ensures
deaths 3 Set 0 firebat block1
return

:ygg_idle
issue_order 166 100 57 Loc.66 Loc.66 57 0
wait_rand 433 800

goto ygg_idle
