script_name Brood Wars Zerg 5 - Town A
script_id ZB5A

start_campaign
start_areatown
defaultbuild_off
default_min 0
wait 1

build 1 hatchery 80
build 2 drone 80
build 1 spawning_pool 80
player_need 1 evolution_chamber
player_need 1 queen_nest
build 1 ultralisk_cavern 80
build 1 defiler_mound 80
build 2 creep_colony 80
build 1 spore_colony 80
build 1 sunken_colony 80
max_workers 12
wait 11500

call wait_attack
call hold_attack
train 3 ultralisk
attack_add 3 ultralisk
attack_to Loc.42 Loc.55
wait 500

attack_do
attack_clear
build 3 drone 80
call release_attack
upgrade 1 ultralisk_speed 30
wait 7500

call wait_attack
call hold_attack
train 2 defiler
train 4 ultralisk
attack_add 2 defiler
attack_add 4 ultralisk
call waypointing
wait 500

attack_do
attack_clear
defensebuild_gg 1 ultralisk
defenseuse_gg 1 ultralisk
defensebuild_ag 1 defiler
defenseuse_ag 1 defiler
build 4 creep_colony 80
build 2 spore_colony 80
build 2 sunken_colony 80
build 1 lair 80
build 1 hive 80
build 12 drone 80
call release_attack
upgrade 1 voracity 30
wait 8900

call wait_attack
call hold_attack
train 6 ultralisk
attack_add 6 ultralisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
upgrade 1 ultralisk_armor 30
build 6 creep_colony 80
build 4 sunken_colony 80
:purple_loop
wait 6000

call wait_attack
call hold_attack
train 2 defiler
train 8 ultralisk
attack_add 2 defiler
attack_add 8 ultralisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
wait 8500

call wait_attack
call hold_attack
train 12 ultralisk
attack_add 12 ultralisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
goto purple_loop

:hold_attack
deaths 3 Add 1 firebat purple_loop
return

:release_attack
deaths 3 Set 0 firebat purple_loop
return

:wait_attack
wait 16

deaths 3 AtLeast 2 firebat ensure_attack
deaths 3 Exactly 1 firebat wait_attack
#loop if another script started an attack
return

:ensure_attack
load_bank Ensures
print Ensure_TwoOrMore_PleaseReportMeIfSeen
bank_data Set 1 Ensures Ensure_TwoOrMore wait_attack
bank_data Set 0 Ensures Ensure_Compare wait_attack
save_bank Ensures
deaths 3 Set 0 firebat purple_loop
return

:waypointing
wait 16

#pick targets based on player presence, fallback to random otherwise
#should not trigger ensure because this is only ran after the safeguard
#use CARRIER death to force fallback
random_jump 64 middle_approach
random_jump 85 north_approach
random_jump 128 south_approach
unstart_campaign
attack_prepare
start_campaign
return

:nomiddle
wait 8

deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 north_approach
random_jump 128 south_approach
goto waypointing

:nosouth
wait 8

deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 north_approach
random_jump 128 middle_approach
goto waypointing

:nonorth
wait 8

random_jump 64 target_player_island
deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 middle_approach
random_jump 128 south_approach
goto waypointing

:target_player_island
attack_to Loc.54 Loc.55
return

:north_approach
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.61 nonorth
random_jump 85 alt_north
attack_to Loc.62 Loc.61
return

:alt_north
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.31 nonorth
attack_to Loc.62 Loc.31
return

:south_approach
wait 8

random_jump 128 alt_south
attack_to Loc.20 Loc.60
return

:alt_south
wait 8

bring_jump 14 AtMost 3 group_buildings Loc.114 nosouth
attack_to Loc.64 Loc.65
return

:middle_approach
wait 8

random_jump 128 alt_middle
bring_jump 14 AtMost 1 group_buildings Loc.13 nomiddle
attack_to Loc.42 Loc.13
return

:alt_middle
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.22 nomiddle
attack_to Loc.42 Loc.22
return

:fallback
deaths 13 Set 0 carrier waypointing
attack_prepare
return
