script_name Brood Wars Zerg 2 - Town D
script_id ZB2D

start_campaign
wait 1

start_town
defaultbuild_off
default_min 0
wait 1

notowns_jump hive red_defender
multirun taar_upgrades
unit_avail 13 Set Disabled spawnsire taar_idle
define_max 12 broodling
define_max 255 spawnsire
define_max 8 scourge
define_max 20 overlord
define_max 6 sy_demon
define_max 6 ortu
define_max 25 gray
defensebuild_gg 1 sy_demon
defenseuse_gg 1 sy_demon
defensebuild_gg 1 gray
defenseuse_gg 1 gray
defensebuild_gg 1 sy_demon
defenseuse_gg 1 sy_demon
defensebuild_gg 1 ortu
defenseuse_gg 1 ortu
defensebuild_ag 2 gray
defenseuse_ag 2 gray
defensebuild_ga 1 ortu
defenseuse_ga 1 ortu
:taar_idle
wait 50

enemyowns_jump hatchery zerg_raid
enemyowns_jump lair zerg_raid
enemyowns_jump hive zerg_raid
deaths 13 Exactly 1 194 taar_idle
#loop while exactly 1 extended zeratul deaths
:taar_ambush
unit_avail 13 Set Enabled spawnsire taar_idle
define_max 8 spawnsire
defensebuild_gg 1 spawnsire
:taar_loop
wait 1533

train 20 gray
attack_add 20 gray
attack_prepare
wait 500

attack_do
attack_clear
wait 2750

train 4 sy_demon
train 14 gray
attack_add 4 sy_demon
attack_add 14 gray
attack_prepare
wait 500

attack_do
attack_clear
train 5 ortu
attack_add 5 ortu
attack_prepare
wait 500

attack_do
attack_clear
wait 3050

train 6 sy_demon
attack_add 6 sy_demon
attack_prepare
wait 500

attack_do
attack_clear
train 22 gray
train 4 ortu
attack_add 22 gray
attack_add 4 ortu
attack_prepare
wait 500

attack_do
attack_clear
goto taar_loop

:zerg_raid
#when this first happens, set a death that triggers a dialogue in the map!
train 4 ortu
train 2 sy_demon
attack_rand 2 4 ortu
attack_rand 1 2 sy_demon
unstart_campaign
attack_prepare
start_campaign
wait 500

attack_do
attack_clear
wait 1000

deaths 13 Exactly 0 194 taar_ambush
wait 1000

deaths 13 Exactly 0 194 taar_ambush
wait_rand 533 1515

goto taar_idle

:taar_upgrades
idle_orders DisableBuiltin 0 0 0 0 0 0 0
upgrade 1 defiler_mana 30
upgrade 1 queen_mana 30
upgrade 3 z_missile_attack 30
upgrade 3 z_carapace 30
upgrade 3 z_melee_attack 30
upgrade 3 z_flyer_carapace 30
upgrade 3 z_flyer_attack 30
upgrade 1 bone_mastery 30
#special taar broodling upgrade? taar units to be added!
defensebuild_gg 1 broodling
defenseuse_gg 2 broodling
defensebuild_gg 1 spawnsire
defenseuse_gg 1 spawnsire
defensebuild_ag 1 defiler
defenseuse_ag 1 defiler
defensebuild_ag 2 scourge
defenseuse_ag 2 scourge
defensebuild_aa 2 scourge
defenseuse_aa 2 scourge
#upgrade 1 lurker_speed 60
tech consume 30
tech plague 30
idle_orders 120 0 1 queen 1024 overlord|observer|science_vessel|defiler|skywing|dropship|shuttle|arbiter|valhalla|defiler|queen|ghost 30 WithoutSpellEffects(Parasite)|RandomRate(280 820)|Self(Energy(GreaterThanPercent 50))
tech spawn_broodling 60
idle_orders 121 32 1 queen 312 zergling|marine 5 Health(GreaterThanPercent 85)|Self(Energy(GreaterThanPercent 75))
idle_orders 121 32 1 queen 312 hydralisk|firebat|medic|heavy_marine 40 Health(GreaterThanPercent 85)
