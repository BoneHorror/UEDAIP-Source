train 2 spawnsire
train 10 gray
train 2 atril
train 18 gray
attack_add 2 spawnsire
attack_add 2 atril
attack_add 18 gray
call attackTargeting
wait 500

attack_do
attack_clear
train 6 ortu
attack_add 6 ortu
attack_to Loc.58 Loc.55
wait 500

attack_do
attack_clear
build 1 hive 80
build 2 queen_nest 80
upgrade 1 82 30
#upgrade taar gray plasma overcharge - to add to defs later
upgrade 1 z_flyer_carapace 30
upgrade 2 z_melee_attack 30
