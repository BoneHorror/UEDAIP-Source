:taar_loop
wait 2533

train 6 sy_demon
train 24 gray
attack_add 6 sy_demon
attack_add 24 gray
call attackTargeting
wait 500

attack_do
attack_clear
wait 2750

train 8 ortu
attack_add 8 ortu
attack_to Loc.58 Loc.55
wait 500

attack_do
attack_clear
wait 3250

train 9 sy_demon
train 2 defiler
train 6 scourge
train 18 sy_demon
attack_add 6 scourge
attack_add 2 defiler
attack_add 18 sy_demon
call attackTargeting
wait 500

attack_do
attack_clear
train 14 gray
train 3 spawnsire
train 4 atril
train 22 gray
attack_add 3 spawnsire
attack_add 22 gray
attack_add 4 atril
call attackTargeting
wait 500

attack_do
attack_clear
goto taar_loop

:aggressive_growth
wait_rand 5560 7650
wait 16

expand 5 taar_expansion
goto aggressive_growth

:taar_expansion
start_town
build 1 hatchery 100
get_oldpeons 1
wait_build 1 hatchery
build 3 drone 80
build 2 creep_colony 80
wait_buildstart 1 creep_colony
build 1 psi_dominator 100
build 15 drone 80
wait_build 1 psi_dominator
build 2 xenowort 80
build 2 spore_colony 80
place_guard gray 0
place_guard gray 2
:idle_loop
wait 1500

goto idle_loop

:attackTargeting
random_jump 128 specific_target
unstart_campaign
attack_prepare
start_campaign
return

:specific_target
random_jump 85 go_through_mid
#target player
attack_to Loc.50 Loc.55
return

:go_through_mid
attack_to Loc.55 Loc.59
return
