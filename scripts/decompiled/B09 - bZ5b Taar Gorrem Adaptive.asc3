script_name Brood Wars Zerg 5 - Town B
script_id ZB5B

start_campaign
wait 1

start_town
defaultbuild_off
default_min 0
wait 1

build 15 drone 80
build 1 hatchery 80
build 1 spawning_pool 80
build 1 evolution_chamber 80
#set crimson player color
upgrade_jump 13 Set 81 4 taar_loop
define_max 45 drone
define_max 255 queen
define_max 2 defiler
define_max 255 broodling
define_max 255 spawnsire
define_max 8 scourge
define_max 25 overlord
define_max 6 atril
define_max 6 sy_demon
define_max 8 ortu
define_max 27 gray
define_max 10 gorrem
max_force 1100
upgrade 1 overlord_speed 30
upgrade 1 overlord_capacity 30
max_workers 45
wait 1050

multirun cr_loop
multirun timer_mapside
train 6 gray
attack_add 6 gray
attack_to Loc.56 Loc.57
#attack towards player
wait 500

attack_do
attack_clear
upgrade 1 z_missile_attack 30
defensebuild_gg 2 sy_demon
defenseuse_gg 2 sy_demon
defensebuild_gg 2 gray
defenseuse_gg 2 gray
defensebuild_ag 2 gray
defenseuse_ag 2 gray
expand 1 taar_expansion
build 1 lair 80
build 1 xenowort 80
build 4 creep_colony 80
build 2 spore_colony 80
build 2 sunken_colony 80
wait 1500

build 1 spire 80
build 25 drone 80
wait 933

multirun aggressive_growth
build 2 xenowort 80
build 1 spire 80
build 1 queen_nest 80
upgrade 2 z_missile_attack 30
upgrade 1 z_flyer_attack 30
defensebuild_gg 1 ortu
defenseuse_gg 1 ortu
defensebuild_ga 1 ortu
defenseuse_ga 1 ortu
defensebuild_aa 1 scourge
defenseuse_aa 1 scourge
build 2 psi_dominator 80
goto opening_attack

:opening_return
build 1 hive 80
build 2 evolution_chamber 80
upgrade 2 z_flyer_attack 30
defensebuild_gg 1 atril
defenseuse_gg 1 atril
idle_orders 119 64 1 atril 256 group_men 55 count(AtLeast 2 106 14)|WithoutUnitFlags(Air)
idle_orders 119 64 1 atril 256 group_men 70 count(AtLeast 3 106 14)|WithoutUnitFlags(Air)
idle_orders 119 64 1 atril 256 group_men 110 count(AtLeast 4 106 14)|WithoutUnitFlags(Air)
idle_orders 119 64 1 atril 256 photon_cannon|sunken_colony|creep_colony|spore_colony|bunker|missile_turret|drone|probe|scv 100 count(AtLeast 2 106 14)
wait 2240

upgrade 1 z_carapace 30
build 3 psi_dominator 80
build 3 xenowort 80
train 4 atril
train 8 gray
attack_add 4 atril
attack_add 8 gray
attack_to Loc.20 Loc.2
wait 500

attack_do
attack_clear
build 1 defiler_mound 80
upgrade 1 atril_death 30
upgrade 3 z_missile_attack 30
defensebuild_gg 1 gorrem
defenseuse_gg 1 gorrem
defensebuild_ag 1 gorrem
defenseuse_ag 1 gorrem
train 1 gorrem
idle_orders 119 1024 1 gorrem 256 hatchery|lair|hive 55 own|allied|notenemies
idle_orders 119 85 1 gorrem 256 group_factories 55 0
train 6 gorrem
attack_add 6 gorrem
attack_to Loc.52 Loc.55
wait 500

attack_do
attack_clear
place_guard gorrem 0
place_guard gorrem 2
#upgrade taar gray plasma overcharge - to add to defs later
upgrade 1 z_flyer_carapace 30
train 8 gray
train 4 sy_demon
train 4 ortu
train 3 atril
attack_add 8 gray
attack_add 4 sy_demon
attack_add 4 ortu
attack_add 3 atril
attack_to Loc.20 Loc.2
wait 500

attack_do
attack_clear
wait 2550

upgrade 1 gray_rounds 30
defensebuild_ag 1 defiler
defenseuse_ag 1 defiler
idle_orders 119 64 1 defiler 512 spawnsire 40 own|allied|notenemies|incombat
idle_orders 119 64 1 defiler 512 spawnsire|broodling 60 own|allied|notenemies|incombat|Count(AtLeast 6 80 14)
idle_orders 119 64 1 defiler 512 sy_demon 50 own|allied|notenemies|incombat|Count(AtLeast 2 80 14)
idle_orders 119 64 1 defiler 512 sy_demon 70 own|allied|notenemies|incombat|Count(AtLeast 4 80 14)
idle_orders 119 64 1 defiler 512 sy_demon 90 own|allied|notenemies|incombat|Count(AtLeast 7 100 14)
idle_orders 119 64 1 gray 192 group_men 55 count(AtLeast 2 80 14)|WithoutUnitFlags(Air)
idle_orders 119 64 1 gray 192 group_men 70 count(AtLeast 3 80 14)|WithoutUnitFlags(Air)
idle_orders 119 64 1 gray 192 group_men 110 count(AtLeast 4 80 14)|WithoutUnitFlags(Air)
idle_orders 119 64 1 gray 192 zealot|zergling|marine|heavy_marine|scv|probe|drone 110 count(AtLeast 3 80 14)|WithoutUnitFlags(Air)
goto midgame_attack

:midgame_return
tech plague 30
upgrade 2 z_melee_attack 30
upgrade 3 z_carapace 30
upgrade 3 z_melee_attack 30
upgrade 3 z_flyer_carapace 30
upgrade 3 z_flyer_attack 30
max_workers 255
idle_orders 144 64 1 defiler 788 group_men 55 count(AtLeast 3 120 14) 
idle_orders 144 64 1 defiler 512 skywing|death_knight|scorpion|wraith|science_vessel|dragoon|corsair|scout 80 incombat|count(AtLeast 3 120 14)
idle_orders 144 64 1 defiler 512 hnorad|battlecruiser|valhalla|carrier|arbiter|devourer|guardian|ultralisk 115 incombat|count(AtLeast 2 120 14)
idle_orders 144 64 1 defiler 512 hnorad|battlecruiser|valhalla|carrier|arbiter|ultralisk 80 incombat
idle_orders 144 64 1 defiler 512 heavy_marine|medic|ghost|phantom|marine|firebat|vulture|zealot|hydralisk|mutalisk|revenant|dark_templar|high_templar 55 incombat|count(AtLeast 4 120 14)
:taar_loop
wait 2350

train 6 sy_demon
train 6 ortu
attack_add 6 sy_demon
attack_add 6 ortu
call attackTargeting
wait 500

attack_do
attack_clear
wait 3150

train 10 gorrem
attack_add 10 gorrem
call attackTargeting
wait 500

attack_do
attack_clear
wait 2750

train 20 gray
train 7 gorrem
train 3 sy_demon
attack_add 20 gray
attack_add 5 gorrem
attack_add 3 sy_demon
call attackTargeting
wait 500

attack_do
attack_clear
train 6 ortu
train 4 atril
attack_add 6 ortu
attack_add 4 atril
attack_add 2 gorrem
call attackTargeting
wait 500

attack_do
attack_clear
goto taar_loop

:aggressive_growth
wait_rand 5560 7650
wait 16

expand 5 taar_expansion
goto aggressive_growth

:taar_expansion
start_town
build 1 hatchery 100
get_oldpeons 1
wait_build 1 hatchery
build 3 drone 80
build 2 creep_colony 80
wait_buildstart 1 creep_colony
build 1 psi_dominator 100
build 15 drone 80
wait_build 1 psi_dominator
build 2 xenowort 80
build 2 spore_colony 80
place_guard gray 0
place_guard gray 2
wait_rand 9500 11500

place_guard gorrem 0
:idle_loop
wait 1500

goto idle_loop

:attackTargeting
random_jump 128 specific_target
unstart_campaign
attack_prepare
start_campaign
return

:specific_target
random_jump 85 go_through_mid
#target player
attack_to Loc.50 Loc.55
return

:go_through_mid
attack_to Loc.56 Loc.59
return

:cr_loop
wait 1

wait_rand 133 650
harass_location
goto cr_loop

:timer_mapside
wait 1

deaths 13 Exactly 0 battlecruiser timer_mapside
deaths 13 Subtract 1 battlecruiser timer_mapside
goto timer_mapside

:opening_attack
deaths 13 Set 1 wraith timer_mapside
wait 5

#set wraith death to ally to Orange for 50 frames
rush 9 opening_noair
train 4 ortu
attack_add 4 ortu
attack_to Loc.58 Loc.55
:opening_execute
wait 500

attack_do
attack_clear
goto opening_return

:opening_noair
rush 27 opening_sy
train 12 gray
attack_add 12 gray
attack_to Loc.50 Loc.51
goto opening_execute

:opening_sy
train 4 sy_demon
attack_add 4 sy_demon
attack_to Loc.42 Loc.51
goto opening_execute

:midgame_attack
deaths 13 Set 1 wraith timer_mapside
wait 5

call mid_first
wait 500

attack_do
attack_clear
call mid_second
attack_to Loc.20 Loc.2
wait 500

attack_do
attack_clear
upgrade 1 z_melee_attack 30
upgrade 2 z_carapace 30
upgrade 2 z_flyer_carapace 30
wait 2750

deaths 13 Set 1 wraith timer_mapside
wait 5

call mid_third
attack_to Loc.50 Loc.55
wait 500

attack_do
attack_clear
goto midgame_return

:mid_first
rush 19 mf_alt1
train 8 ortu
attack_add 8 ortu
attack_to Loc.58 Loc.51
return

:mf_alt1
rush 29 mf_alt2
train 27 gray
attack_add 27 gray
attack_to Loc.52 Loc.51
return

:mf_alt2
train 6 sy_demon
train 2 atril
attack_add 6 sy_demon
attack_add 2 atril
attack_to Loc.50 Loc.51
return

:mid_second
train 4 gorrem
attack_add 4 gorrem
return

:mid_third
rush 14 mt_alt1
train 4 gorrem
train 4 sy_demon
attack_add 4 gorrem
attack_add 4 sy_demon
return

:mt_alt1
rush 10 mt_alt2
train 4 gorrem
train 6 ortu
attack_add 4 gorrem
attack_add 6 ortu
return

:mt_alt2
train 6 gorrem
attack_add 6 gorrem
return

