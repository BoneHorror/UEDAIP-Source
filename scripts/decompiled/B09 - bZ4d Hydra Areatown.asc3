script_name Brood Wars Zerg 4 - Town D
script_id ZB4D

start_campaign
start_areatown
defaultbuild_off
default_min 0
wait 1

build 1 hatchery 80
build 4 drone 80
player_need 1 spawning_pool
build 1 hydralisk_den 80
build 1 evolution_chamber 80
build 2 creep_colony 80
build 1 spore_colony 80
build 1 sunken_colony 80
max_workers 8
wait 1850

call wait_attack
call hold_attack
train 3 hydralisk
train 2 hhydralisk
attack_add 3 hydralisk
attack_add 2 hhydralisk
attack_to Loc.20 Loc.60
wait 500

attack_do
attack_clear
build 6 drone 80
call release_attack
wait 4300

call wait_attack
call hold_attack
train 6 hydralisk
attack_add 6 hydralisk
call waypointing
wait 500

attack_do
attack_clear
build 8 drone 80
call release_attack
wait 5100

call wait_attack
call hold_attack
train 12 hydralisk
attack_add 12 hydralisk
attack_to Loc.42 Loc.55
wait 500

attack_do
attack_clear
call release_attack
wait 4050

call wait_attack
call hold_attack
train 6 hhydralisk
attack_add 6 hhydralisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
build 1 nydus_canal 80
wait 5000

call wait_attack
call hold_attack
train 11 hydralisk
train 4 hhydralisk
attack_add 4 hhydralisk
attack_add 11 hydralisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
:purple_loop
wait 4100

call wait_attack
call hold_attack
train 8 hhydralisk
attack_add 8 hhydralisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
wait 4700

call wait_attack
call hold_attack
train 17 hydralisk
attack_add 17 hydralisk
call waypointing
wait 500

attack_do
attack_clear
call release_attack
goto purple_loop

:hold_attack
deaths 3 Add 1 firebat purple_loop
return

:release_attack
deaths 3 Set 0 firebat purple_loop
return

:wait_attack
wait 16

deaths 3 AtLeast 2 firebat ensure_attack
deaths 3 Exactly 1 firebat wait_attack
#loop if another script started an attack
return

:ensure_attack
load_bank Ensures
print Ensure_TwoOrMore_PleaseReportMeIfSeen
bank_data Set 1 Ensures Ensure_TwoOrMore wait_attack
bank_data Set 0 Ensures Ensure_Compare wait_attack
save_bank Ensures
deaths 3 Set 0 firebat purple_loop
return

:waypointing
wait 16

#pick targets based on player presence, fallback to random otherwise
#should not trigger ensure because this is only ran after the safeguard
#use CARRIER death to force fallback
random_jump 64 middle_approach
random_jump 85 north_approach
random_jump 128 south_approach
unstart_campaign
attack_prepare
start_campaign
return

:nomiddle
wait 8

deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 north_approach
random_jump 128 south_approach
goto waypointing

:nosouth
wait 8

deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 north_approach
random_jump 128 middle_approach
goto waypointing

:nonorth
wait 8

random_jump 64 target_player_island
deaths 3 AtLeast 3 carrier fallback
deaths 3 Add 1 carrier fallback
random_jump 85 middle_approach
random_jump 128 south_approach
goto waypointing

:target_player_island
attack_to Loc.54 Loc.55
return

:north_approach
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.61 nonorth
random_jump 85 alt_north
attack_to Loc.62 Loc.61
return

:alt_north
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.31 nonorth
attack_to Loc.62 Loc.31
return

:south_approach
wait 8

random_jump 128 alt_south
attack_to Loc.20 Loc.60
return

:alt_south
wait 8

bring_jump 14 AtMost 3 group_buildings Loc.114 nosouth
attack_to Loc.64 Loc.65
return

:middle_approach
wait 8

random_jump 128 alt_middle
bring_jump 14 AtMost 1 group_buildings Loc.13 nomiddle
attack_to Loc.42 Loc.13
return

:alt_middle
wait 8

bring_jump 14 AtMost 1 group_buildings Loc.22 nomiddle
attack_to Loc.42 Loc.22
return

:fallback
deaths 13 Set 0 carrier waypointing
attack_prepare
return
