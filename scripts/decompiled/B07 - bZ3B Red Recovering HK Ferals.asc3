:block1
wait 2525

attack_add 12 zergling
attack_add 5 hydralisk
attack_prepare
wait 500

attack_do
attack_clear
wait 3025

attack_add 5 hhydralisk
attack_add 10 hydralisk
attack_prepare
wait 500

attack_do
attack_clear
wait 3500

attack_add 10 zergling
attack_add 2 ultralisk
attack_add 3 hhydralisk
attack_prepare
wait 500

attack_do
attack_clear
goto block1

:ai_income
wait 16

resources_jump 2000 2000 income_throttle
resources 13 Add Ore 6 ai_income
resources 13 Add Gas 4 ai_income
goto ai_income

:income_throttle
wait_rand 500 1500

goto ai_income

